{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CadReader",
  "version": "0.1.0",
  "identifier": "com.drogonz.cadreader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CadReader",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "GraphicsAndDesign",
    "shortDescription": "轻量、只读的本地 DWG 图纸查看器",
    "longDescription": "使用 WebAssembly 解析并通过 WebGL 渲染 DWG 图纸。文件只在本机读取，不会上传。",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
